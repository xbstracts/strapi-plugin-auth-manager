{
  "kind": "collectionType",
  "collectionName": "auth_manager_authentications",
  "info": {
    "singularName": "authentication",
    "pluralName": "authentications",
    "displayName": "Authentication",
    "description": "Authentication provider identities linked to mapped user records"
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": true
    }
  },
  "options": {
    "draftAndPublish": false,
    "privateAttributes": [
      "userCollection",
      "userDocumentId"
    ]
  },
  "attributes": {
    "provider": {
      "type": "enumeration",
      "enum": [
        "supertokens"
      ],
      "required": true,
      "default": "supertokens"
    },
    "providerUserId": {
      "type": "string",
      "required": true
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "user": {
      "type": "relation",
      "relation": "morphToOne"
    },
    "userCollection": {
      "type": "string",
      "private": true
    },
    "userDocumentId": {
      "type": "string",
      "private": true
    },
    "metadata": {
      "type": "json"
    },
    "lastSyncedAt": {
      "type": "datetime"
    }
  }
}
